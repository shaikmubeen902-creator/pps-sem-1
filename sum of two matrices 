#include <stdio.h>

void main() 
{
    int a[2][2], b[2][2], c[2][2], i, j;

    printf("Enter 4 values for matrix a:\n");
    for(i = 0; i < 2; i++) {
        for(j = 0; j < 2; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    printf("Enter 4 values for matrix b:\n");
    for(i = 0; i < 2; i++) {
        for(j = 0; j < 2; j++) {
            scanf("%d", &b[i][j]);
        }
    }

    // Adding matrices and printing the result
    printf("Sum of the two matrices:\n");
    for(i = 0; i < 2; i++) {
        for(j = 0; j < 2; j++) {
            c[i][j] = a[i][j] + b[i][j];
            printf("%d\t", c[i][j]);
        }
        printf("\n"); // Moves to the next row
    }
}
